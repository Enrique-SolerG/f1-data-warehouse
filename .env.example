# Copy to .env and fill in. .env is gitignored, this file is the template.

# Linux only: your host uid, so files written into bind mounts aren't root-owned.
# Harmless to leave as default on macOS/Windows.
AIRFLOW_UID=50000

# Generate with:
#   uv run python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
FERNET_KEY=

# Generate with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# Airflow UI admin account, created once by airflow-init
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Warehouse Postgres (separate from Airflow's own metadata database)
# HOST/PORT here are consumed inside the Airflow containers (this file is
# loaded via docker-compose.yml's env_file), so they use compose's internal
# service DNS: the "warehouse" service, port 5432 - NOT the 5433 host-side
# mapping. To connect from your own machine (psql, DBeaver, a local script
# run outside Docker), use localhost:5433 instead - that mapping is only
# reachable from the host, never from inside another container.
WAREHOUSE_POSTGRES_USER=warehouse
WAREHOUSE_POSTGRES_PASSWORD=warehouse
WAREHOUSE_POSTGRES_DB=telemetry
WAREHOUSE_POSTGRES_HOST=warehouse
WAREHOUSE_POSTGRES_PORT=5432
